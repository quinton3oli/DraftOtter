{
	"name": "DraftOtter",
	"short_name": "DraftOtter",
	"description": "A precise CAD app for designing 3D-printable parts. Works offline; your designs stay on your device.",
	"id": "/",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"display_override": ["window-controls-overlay", "standalone"],
	"background_color": "#141a22",
	"theme_color": "#141a22",
	"categories": ["productivity", "utilities", "design"],
	"icons": [
		{ "src": "icons/draftotter-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
		{ "src": "icons/draftotter-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
		{ "src": "icons/draftotter-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
	],
	"file_handlers": [
		{
			"action": "/",
			"accept": { "application/json": [".json", ".lcad"] },
			"icons": [{ "src": "icons/draftotter-192.png", "sizes": "192x192", "type": "image/png" }],
			"launch_type": "single-client"
		}
	],
	"launch_handler": { "client_mode": "focus-existing" }
}
